import json
import threading
import unittest
import urllib.request

from app.main import HEALTH_PATH, handle, make_server
from app.modules import ROUTES


class HandleTests(unittest.TestCase):
    def test_health_is_ok(self):
        self.assertEqual(handle(HEALTH_PATH), (200, {"status": "ok"}))

    def test_every_module_route_answers(self):
        for path in ROUTES:
            with self.subTest(path=path):
                status, _ = handle(path)
                self.assertEqual(status, 200)

    def test_unknown_path_is_not_found(self):
        status, _ = handle("/no-such-path")
        self.assertEqual(status, 404)


class ServerTests(unittest.TestCase):
    def setUp(self):
        self.server = make_server(0)
        threading.Thread(target=self.server.serve_forever, daemon=True).start()
        self.base = f"http://127.0.0.1:{self.server.server_address[1]}"

    def tearDown(self):
        self.server.shutdown()
        self.server.server_close()

    def test_health_over_http(self):
        with urllib.request.urlopen(self.base + HEALTH_PATH) as response:
            self.assertEqual(response.status, 200)
            self.assertEqual(json.load(response), {"status": "ok"})


if __name__ == "__main__":
    unittest.main()
