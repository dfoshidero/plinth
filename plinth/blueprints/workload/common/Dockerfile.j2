FROM {{ defaults.PYTHON_IMAGE }}

# links the image to its repository (on ghcr.io this also grants the repo access to it)
LABEL org.opencontainers.image.source="{{ repo.web_url }}"
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    APP_NAME={{ workload.name }}
WORKDIR /srv
RUN useradd --system --uid 10001 --no-create-home app
COPY app ./app
USER 10001
{% if workload.port %}
ENV PORT={{ workload.port }}
EXPOSE {{ workload.port }}
{% endif %}
CMD ["python", "-m", "app.main"]
