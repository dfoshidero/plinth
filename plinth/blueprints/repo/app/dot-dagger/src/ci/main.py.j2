"""Test, build, publish and release every workload in this repository.

Workloads are discovered from their score.yaml files, so adding one needs no change here.
"""

from __future__ import annotations

import posixpath
from typing import Annotated

import dagger
import yaml
from dagger import DefaultPath, Doc, dag, function, object_type

PROJECT = "{{ project.name }}"
REGISTRY = "{{ project.registry }}"
APP_REPO_URL = "{{ repo.url }}"
GITOPS_REPO_URL = "{{ plan.gitops.url }}"
RELEASE_ENVIRONMENT = "{{ defaults.RELEASE_ENVIRONMENT }}"
GIT_TOKEN_USER = "{{ git_token_user }}"
PYTHON_IMAGE = "{{ defaults.PYTHON_IMAGE }}"
GIT_IMAGE = "{{ defaults.GIT_IMAGE }}"

Source = Annotated[dagger.Directory, DefaultPath("/"), Doc("repository root")]

RELEASE_SCRIPT = r"""
set -eu
git clone -q --depth 1 "https://${GIT_TOKEN_USER}:${GIT_TOKEN}@${GITOPS_REPO_URL#https://}" /gitops
cp -R /release/. /gitops/
cd /gitops
git config user.name "${PROJECT} CI"
git config user.email "ci@${PROJECT}.invalid"
git add -A
if git diff --cached --quiet; then echo "nothing to release"; exit 0; fi
git commit -q -m "release: ${RELEASE_SUMMARY}"
git push -q origin HEAD
"""


@object_type
class Ci:
    @function
    async def workloads(self, source: Source) -> list[str]:
        """List discovered workloads as name=directory."""
        return [f"{name}={path}" for name, path in await _discover(source)]

    @function
    async def test(self, source: Source) -> str:
        """Run every workload's unit tests."""
        reports = []
        for name, path in await _discover(source):
            report = await (
                dag.container()
                .from_(PYTHON_IMAGE)
                .with_directory("/src", source.directory(path))
                .with_workdir("/src")
                .with_exec(["python", "-m", "unittest", "discover", "-s", "tests", "-t", ".", "-v"])
                .stderr()
            )
            reports.append(f"== {name}\n{report}")
        return "\n".join(reports)

    @function
    async def build(
        self, workload: Annotated[str, Doc("workload name")], source: Source
    ) -> dagger.Container:
        """Build one workload's container image."""
        paths = dict(await _discover(source))
        if workload not in paths:
            raise ValueError(f"unknown workload {workload!r}; known: {', '.join(paths)}")
        return source.directory(paths[workload]).docker_build()

    @function
    async def ship(
        self,
        commit: Annotated[str, Doc("commit SHA being shipped; used as image tag and app revision")],
        registry_username: str,
        registry_password: dagger.Secret,
        git_token: Annotated[dagger.Secret, Doc("token that can push to the GitOps repository")],
        source: Source,
    ) -> str:
        """Test, publish every image, then record the release in the GitOps repository."""
        await self.test(source)
        registry_host = REGISTRY.split("/", 1)[0]
        release = dag.directory()
        published, names = [], []
        for name, path in await _discover(source):
            ref = await (
                source.directory(path)
                .docker_build()
                .with_registry_auth(registry_host, registry_username, registry_password)
                .publish(f"{REGISTRY}/{PROJECT}-{name}:{commit}")
            )
            record = {
                "workload": name,
                "image": ref,
                "revision": commit,
                "appRepoURL": APP_REPO_URL,
                "scorePath": "score.yaml" if path == "." else posixpath.join(path, "score.yaml"),
            }
            release = release.with_new_file(
                f"environments/{RELEASE_ENVIRONMENT}/{name}/release.yaml",
                yaml.safe_dump(record, sort_keys=False),
            )
            published.append(ref)
            names.append(name)

        await (
            dag.container()
            .from_(GIT_IMAGE)
            .with_exec(["apk", "add", "--no-cache", "git"])
            .with_directory("/release", release)
            .with_env_variable("GITOPS_REPO_URL", GITOPS_REPO_URL)
            .with_env_variable("GIT_TOKEN_USER", GIT_TOKEN_USER)
            .with_env_variable("PROJECT", PROJECT)
            .with_env_variable("RELEASE_SUMMARY", f"{', '.join(names)} {commit[:12]}")
            .with_secret_variable("GIT_TOKEN", git_token)
            .with_exec(["sh", "-c", RELEASE_SCRIPT])
            .sync()
        )
        return "\n".join(published)


async def _discover(source: dagger.Directory) -> list[tuple[str, str]]:
    found = []
    for path in sorted(await source.glob("**/score.yaml")):
        if path.startswith(".dagger/"):
            continue
        spec = yaml.safe_load(await source.file(path).contents())
        found.append((spec["metadata"]["name"], posixpath.dirname(path) or "."))
    if not found:
        raise ValueError("no score.yaml found; nothing to do")
    return found
