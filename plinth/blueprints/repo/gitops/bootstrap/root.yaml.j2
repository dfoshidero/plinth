# Apply once: kubectl apply -n argocd -f bootstrap/root.yaml
# Argo CD then manages everything under apps/.
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: {{ project.name }}-root
  namespace: argocd
spec:
  project: default
  source:
    repoURL: {{ repo.url }}
    targetRevision: HEAD
    path: apps
  destination:
    server: https://kubernetes.default.svc
    namespace: argocd
  syncPolicy:
    automated:
      prune: false
      selfHeal: true
