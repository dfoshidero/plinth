# Each release passes, in order:
#   1. the workload's score.yaml (metadata, containers.main, service)
#   2. environments/<env>/<workload>/values.yaml (replicas, ...)
#   3. image, set from release.yaml
# Supported Score fields: metadata.name, containers.main (command, args, variables,
# resources, livenessProbe, readinessProbe) and service.ports. Score `resources`
# (databases, queues, ...) are not provisioned by this chart.
image: ""
replicas: 1
# Secrets used to pull private images. scripts/bootstrap-local.sh creates this one when
# REGISTRY_USERNAME and REGISTRY_PASSWORD are set; a missing secret is ignored.
imagePullSecrets:
  - {{ defaults.IMAGE_PULL_SECRET }}
