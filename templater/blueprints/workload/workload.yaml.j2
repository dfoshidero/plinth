apiVersion: platform.dev/v1
kind: Workload
metadata:
  name: {{ workload.name }}
spec:
  source:
    type: local
    context: .
    dockerfile: {{ workload.dockerfile }}
  runtime:
{% if workload.kind == "worker" %}
    type: worker
{% else %}
    type: service
    port: {{ workload.port }}
    healthPath: /health
{% endif %}
  deployment:
    replicas: 1
    resources:
      requests: {cpu: 250m, memory: 256Mi}
      limits: {cpu: "1", memory: 512Mi}
    exposure: internal
